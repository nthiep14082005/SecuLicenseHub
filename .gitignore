# Dependencies
node_modules/
server/node_modules/
client/node_modules/

# Environment & Secrets (TUYỆT ĐỐI không đẩy API key, khóa AES/HMAC hay .env lên Git)
.env
.env.*
server/.env
server/.env.*
client/.env
client/.env.*
!.env.example
*.pem
*.key

# Build outputs
client/dist/
client/.vite/
server/dist/

# Uploaded product images, OCR temp files & digital assets (giữ lại .gitkeep)
server/uploads/*
!server/uploads/.gitkeep
!server/uploads/products/
!server/uploads/ocr/
!server/uploads/assets/
server/uploads/products/*
!server/uploads/products/.gitkeep
server/uploads/ocr/*
!server/uploads/ocr/.gitkeep
server/uploads/assets/*
!server/uploads/assets/.gitkeep
*.tmp

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
logs/
*.log

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
