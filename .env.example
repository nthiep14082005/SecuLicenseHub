# ==============================================================================
# SecuLicense Hub — Biến môi trường mẫu (Copy thành .env để chạy)
# Dùng chung cho 2 môn: Ngôn ngữ kịch bản & Phát triển phần mềm web an toàn
# ==============================================================================

# --- Server & CORS ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- PostgreSQL 16 (Docker Local hoặc Neon Serverless Cloud) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=seculicense_admin
POSTGRES_PASSWORD=seculicense_secret_123
POSTGRES_DB=seculicense_hub

# Cách 1 (Docker Local):
DATABASE_URL=postgresql://seculicense_admin:seculicense_secret_123@localhost:5432/seculicense_hub

# Cách 2 (Neon Serverless PostgreSQL — bỏ comment và thay bằng connection string từ Neon Console):
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-your-endpoint.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Authentication, HttpOnly Cookie & 2FA ---
JWT_SECRET=thay_bang_chuoi_jwt_bi_mat_dai_hon_32_ky_tu_ngau_nhien
JWT_EXPIRES_IN=1d
COOKIE_NAME=seculicense_token
# Bật true khi chạy sau HTTPS production
COOKIE_SECURE=false

# --- Mã hóa AES-256-GCM, HMAC-SHA256 & Signed Download URL ---
# BẮT BUỘC đúng 64 ký tự hex (= 32 bytes). Tạo nhanh bằng:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_256_SECRET_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HMAC_ORDER_SECRET=thay_bang_chuoi_hmac_order_bi_mat_dai_hon_32_ky_tu
SIGNED_URL_SECRET=thay_bang_chuoi_signed_url_bi_mat_dai_hon_32_ky_tu
SIGNED_URL_TTL_SECONDS=300

# --- Meilisearch (Tìm kiếm không dấu, chịu lỗi chính tả) ---
MEILI_HOST=http://localhost:7700
MEILI_PORT=7700
MEILI_MASTER_KEY=seculicense_meili_master_key_2026
MEILI_INDEX_PRODUCTS=seculicense_products

# --- Google Gemini API (Chatbot tư vấn, AI OCR & AI Security Log Analyzer) ---
GEMINI_API_KEY=dien_gemini_api_key_cua_nhom_vao_day
GEMINI_MODEL=gemini-2.5-flash

# --- Thanh toán VietQR (Hiển thị mã QR động) ---
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=SECULICENSE HUB

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:5000/api
